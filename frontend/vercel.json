{
  "rewrites": [
    { "source": "/api/:path*",     "destination": "https://architect-portfolio-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://architect-portfolio-api.onrender.com/uploads/:path*" },
    { "source": "/(.*)",           "destination": "/index.html" }
  ]
}
